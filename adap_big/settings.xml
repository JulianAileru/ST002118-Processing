<?xml version="1.0" encoding="UTF-8"?><settings>
    <universal>
        <mz.tolerance type="mz" unit="da" value="0.05"/>
        <pool.sample.type selected="Pool" type="combo.list">
            <combo value="Pool"/>
            <combo value="NIST"/>
            <combo value="QC"/>
            <combo value="Other"/>
        </pool.sample.type>
    </universal>
    <org.dulab.adapbig.alignment.AlignmentModule>
        <sample.count.ratio type="double" value="0.5"/>
        <ret.time.range type="double" value="0.05"/>
        <score.tolerance type="double" value="0.75"/>
        <score.weight type="double" value="0.1"/>
        <mz.tolerance.with.units type="mz" unit="da" value="0.01"/>
        <exclusion.mz.ranges type="exclusion.mz.ranges" value=""/>
    </org.dulab.adapbig.alignment.AlignmentModule>
    <org.dulab.adapbig.adductsearch.AdductSearchModule>
        <peak.similarity.threshold type="double" value="0.7"/>
        <retention.time.tolerance type="double" value="0.5"/>
        <mass.tolerance.with.units type="mz" unit="ppm" value="15.0"/>
        <min.number.ions type="int" value="1"/>
        <max.number.isotopes type="int" value="3"/>
        <adducts type="adduct.list">
