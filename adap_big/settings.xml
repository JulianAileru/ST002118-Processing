            <adduct adduct.mass="33.033489" charge="1" name="M+CH3OH+H" num.molecules="1" quasi.molecular.ion="false"/>
            <adduct adduct.mass="-35.0139" charge="1" name="M+H-2H2O" num.molecules="1" quasi.molecular.ion="false"/>
            <adduct adduct.mass="1.007276" charge="1" name="2M+H" num.molecules="2" quasi.molecular.ion="false"/>
            <adduct adduct.mass="44.97116" charge="1" name="M+2Na-H" num.molecules="1" quasi.molecular.ion="false"/>
            <adduct adduct.mass="18.033823" charge="1" name="M+NH4" num.molecules="1" quasi.molecular.ion="true"/>
            <adduct adduct.mass="23.996494" charge="2" name="M+H+Na" num.molecules="1" quasi.molecular.ion="false"/>
            <adduct adduct.mass="45.978436" charge="2" name="M+2Na" num.molecules="1" quasi.molecular.ion="false"/>
            <adduct adduct.mass="2.014552" charge="2" name="M+2H" num.molecules="1" quasi.molecular.ion="false"/>
            <adduct adduct.mass="25.00377" charge="3" name="M+2H+Na" num.molecules="1" quasi.molecular.ion="false"/>
            <adduct adduct.mass="46.98382" charge="3" name="M+2Na+H" num.molecules="1" quasi.molecular.ion="false"/>
            <adduct adduct.mass="-3.021828" charge="-3" name="M-3H" num.molecules="1" quasi.molecular.ion="false"/>
            <adduct adduct.mass="-2.014552" charge="-2" name="M-2H" num.molecules="1" quasi.molecular.ion="false"/>
            <adduct adduct.mass="-19.01839" charge="-1" name="M-H2O-H" num.molecules="1" quasi.molecular.ion="false"/>
            <adduct adduct.mass="-1.007276" charge="-1" name="M-H" num.molecules="1" quasi.molecular.ion="true"/>
            <adduct adduct.mass="20.974666" charge="-1" name="M+Na-2H" num.molecules="1" quasi.molecular.ion="false"/>
            <adduct adduct.mass="34.969402" charge="-1" name="M+Cl" num.molecules="1" quasi.molecular.ion="false"/>
            <adduct adduct.mass="36.948606" charge="-1" name="M+K-2H" num.molecules="1" quasi.molecular.ion="false"/>
